  "events": [
    { "id": "w-energie", "country": "global", "title": "Șoc pe piața energiei", "text": "Prețurile la energie urcă brusc pe piețele europene. Guvernele caută soluții, consumatorii caută facturile.", "weight": 3, "cooldown": 5, "effects": { "energy": 35, "inflation": 1.2, "cycle": -0.5 } },
