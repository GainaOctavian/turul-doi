    { "id": "w-boom", "country": "global", "title": "Reluare economică globală", "text": "Comerțul și investițiile revin. Fabricile lucrează pe trei schimburi, iar analiștii revin la optimism.", "weight": 2.5, "cooldown": 4, "effects": { "cycle": 1.2, "inflation": 0.2 } },
