    { "id": "w-dobanzi-jos", "country": "global", "title": "BCE reduce dobânzile", "text": "Banca Centrală Europeană relaxează politica monetară. Statele se îndatorează mai ieftin.", "weight": 2, "cooldown": 4, "effects": { "ecb": -0.5, "cycle": 0.3 } },
    { "id": "w-comert", "country": "global", "title": "Tensiuni comerciale între marile blocuri", "text": "Se impun noi tarife vamale în comerțul transatlantic. Exportatorii își refac planurile.", "weight": 2, "cooldown": 4, "effects": { "cycle": -0.7, "inflation": 0.3 } },
    { "id": "w-pandemie", "country": "global", "title": "Epidemie cu impact economic", "text": "O epidemie se extinde rapid și lovește serviciile și transporturile. Guvernele iau măsuri de urgență.", "weight": 0.5, "cooldown": 10, "effects": { "cycle": -2.6, "inflation": -0.4, "energy": -15 } },
    { "id": "w-energie-jos", "country": "global", "title": "Energia se ieftinește", "text": "Prețurile la energie scad după o iarnă blândă și depozite pline. Facturile respiră ușurate.", "weight": 2, "cooldown": 4, "effects": { "energy": -25, "inflation": -0.5, "cycle": 0.3 } },
